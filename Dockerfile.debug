FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    GLOAN_DATA=/data

WORKDIR /app

# Install debugpy for VS Code remote debugging, Flask + Gunicorn for the server, and Pillow for make_thumbnails.py
COPY requirements.txt ./requirements.txt
COPY tools/requirements.txt ./tools/requirements.txt
RUN pip install --no-cache-dir debugpy -r requirements.txt -r tools/requirements.txt

# Create data directory and permissions
RUN mkdir -p /data

EXPOSE 8000 5678

# Run debugpy listening on 0.0.0.0:5678 without waiting, or use --wait-for-client if you want it to pause at boot
CMD ["python3", "-m", "debugpy", "--listen", "0.0.0.0:5678", "server.py", "--host", "0.0.0.0", "--port", "8000"]
